# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Development & Testing Files (DO NOT COMMIT)
# Debug scripts
check_*.js
test_*.js
test-*.js
debug_*.js
diagnose-*.js
find_*.js
*-test.js

# Log files
*.log
!npm-debug.log*
!yarn-debug.log*
!yarn-error.log*

# Temporary check scripts
check-*.js
quick-*.js
run-*.js

# MCP config (has tokens)
.mcp.json

# Documentation that doesn't need to be in repo
*_REPORT*.md
*_SUMMARY*.md
*_AUDIT*.md
*_FIX*.md
*_INVESTIGATION*.md
DIAGNOSIS_*.md
DEPLOYMENT_*.md
FIXES_*.md

# Test artifacts
test-results/
test-screenshots/
playwright-report/

# Windows artifacts
nul
Thumbs.db

# Duplicate/temp files
appapichatroute.ts
**/duplicate-*.ts
**/duplicate-*.js
