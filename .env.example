# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# AI APIs
# Anthropic Claude (for chat responses)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI (for embeddings and search)
OPENAI_API_KEY=sk-proj-your-key-here
NEXT_PUBLIC_OPENAI_API_KEY=sk-proj-your-key-here

# Optional: OpenCart Integration (for stock sync)
# OPENCART_DB_HOST=mysql.yourdomain.com
# OPENCART_DB_USER=opencart_user
# OPENCART_DB_PASSWORD=your_db_password
# OPENCART_DB_NAME=opencart_database

# Optional: Vercel Cron Authentication
# CRON_SECRET=your_random_secret_for_cron_endpoints
